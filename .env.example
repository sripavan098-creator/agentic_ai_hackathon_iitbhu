# ===========================================
# MediAdvocate Environment Configuration
# ===========================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit the .env file to version control.
# ===========================================

# LLM API Keys (Provide at least one)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tool API Keys
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Local ChromaDB Path
CHROMA_DB_PATH=./chroma_db

# Optional: Document Parser (Unstructured.io)
UNSTRUCTURED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override LLM model (default: gpt-4o)
# LLM_MODEL=gpt-4o
# LLM_MODEL=claude-3-5-sonnet-20241022
